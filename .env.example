# Gemini processes the voice recording on the backend only.
GEMINI_API_KEY=

# Local development keeps data under backend/data by default.
# Production must use an absolute directory on the dedicated local disk.
# FAMILY_DAILY_STORAGE_DIR=/Volumes/FamilyDaily/family-daily
# APP_ENV=production

# Optional local overrides.
# GEMINI_MODEL=gemini-3.7-flash
# ADMIN_API_TOKEN=replace-with-an-admin-token
# ADDR=:8080

# Required when the React frontend is hosted on another origin such as GitHub Pages.
# CORS_ALLOWED_ORIGINS=https://your-name.github.io
# Required in production; must be an HTTPS origin without a path.
# PUBLIC_BASE_URL=https://family-api.example
